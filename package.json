{
  "name": "clr-suspension-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "DEPLOY_TARGET=site npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:trim": "node scripts/trim-bundle.mjs",
    "demo:prep-scan": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/prep-scan.mjs",
    "deploy:site": "node scripts/deploy-to-site.mjs"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "jszip": "^3.10.1",
    "sql.js": "^1.14.1",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.11"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "gltfpack": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  }
}
